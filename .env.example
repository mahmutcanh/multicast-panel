# ── Multicast Control Panel ─────────────────────────────────────────────
# Copy to .env and adjust. install.sh does this automatically and
# generates strong secrets for you.

# ── General ─────────────────────────────────────────────────────────────
NODE_ENV=production
APP_NAME=Multicast Control Panel
# Public URL the panel is reached at (used for CORS, links, HLS URLs).
PUBLIC_URL=http://localhost
# Local/LAN domain (optional, informational)
LOCAL_DOMAIN=
DEFAULT_LOCALE=tr

# ── Ports ───────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=3000

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mcp
DB_USER=mcp
DB_PASSWORD=change-me-db-password

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# ── Security ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# HMAC secret for tokenized HLS/external stream links
STREAM_TOKEN_SECRET=change-me-stream-token-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
SESSION_TIMEOUT_MINUTES=60
# Comma separated CIDRs. Empty = allow all.
IP_ALLOWLIST=
# Cookies require HTTPS when true
SECURE_COOKIES=false

# ── First admin (optional; web installer used when unset) ──────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ── Storage (host paths, bind-mounted into containers) ─────────────────
STORAGE_PATH=./data/media
HLS_PATH=./data/hls
BACKUP_PATH=./data/backups

# ── Streaming ───────────────────────────────────────────────────────────
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VLC_PATH=/usr/bin/cvlc
# Default network interface IP for multicast egress (empty = OS default)
MULTICAST_INTERFACE_IP=
# Base public URL for HLS playback links (defaults to PUBLIC_URL)
HLS_BASE_URL=

# ── SSL ─────────────────────────────────────────────────────────────────
# none | custom | cloudflare  (cloudflare = TLS terminated at tunnel/proxy)
SSL_MODE=none
# Host dir containing fullchain.pem + privkey.pem when SSL_MODE=custom
SSL_CERT_PATH=./docker/nginx/certs

# ── SMTP (alerts, password reset, email verification) ───────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=panel@example.com
SMTP_SECURE=false
